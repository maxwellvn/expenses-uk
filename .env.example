# local enables the "sign in as" developer login on localhost only. Use production when deployed.
APP_ENV=production
# Public base URL, no trailing slash. KingsChat redirects back to APP_URL/auth/callback.
APP_URL=https://expenses.example.org
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=uk_expenses
# Name of the workCentral UK database ONLY when it is on the same MySQL server. Leave empty on Hostinger:
# the app then uses its own `staff` table, filled by deploy/push-staff.sh from the workCentral server.
STAFF_DB=
# Shared secret for POST /sync/staff (64 random hex chars). Same value goes into the cron on the workCentral server.
SYNC_SECRET=
# Comma-separated KingsChat handles that are always admin (cannot be removed in the app).
ADMIN_KC_HANDLES=maxwellvn
KC_CLIENT_ID=
KC_AUTH_URL=https://accounts.kingsch.at/
KC_PROFILE_URL=https://connect.kingsch.at/api/profile
